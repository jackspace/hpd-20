# Coverage configuration for HPD-20 Editor

[run]
source = hpd20
omit =
    */tests/*
    */test_*.py
    */__init__.py
    */ethnic_scales.py
    */instrumentname.py
    */chain.py

[report]
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

[html]
directory = htmlcov

[xml]
output = coverage.xml
